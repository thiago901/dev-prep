# DevPrep — Firebase configuration
#
# The app runs fully without any of this. Leave these blank and every screen
# works, storing progress and recordings in this browser. Fill them in and the
# same code paths switch to Firebase, adding accounts and cross-device sync.
#
# Copy to `.env` and paste the values from:
#   Firebase console -> Project settings -> Your apps -> SDK setup and config
#
# `.env` is gitignored. Never commit real values.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed if you want Analytics.
VITE_FIREBASE_MEASUREMENT_ID=
