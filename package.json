{
  "name": "devprep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Train the act of answering. Technical and behavioral interview preparation for developers targeting international companies.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:content": "tsx --tsconfig tsconfig.app.json scripts/check-content.ts",
    "icons": "node scripts/generate-icons.mjs",
    "check:practice": "tsx --tsconfig tsconfig.app.json scripts/check-practice.ts",
    "check:storage": "tsx --tsconfig tsconfig.app.json scripts/check-storage.ts",
    "check": "npm run typecheck && npm run check:content && npm run check:practice && npm run check:storage && npm run check:seed",
    "seed:all": "tsx --tsconfig tsconfig.app.json scripts/seed.ts",
    "seed:content": "tsx --tsconfig tsconfig.app.json scripts/seed.ts content",
    "seed:taxonomy": "tsx --tsconfig tsconfig.app.json scripts/seed.ts taxonomy",
    "seed:paths": "tsx --tsconfig tsconfig.app.json scripts/seed.ts paths",
    "seed:sources": "tsx --tsconfig tsconfig.app.json scripts/seed.ts sources",
    "seed:dry": "tsx --tsconfig tsconfig.app.json scripts/seed.ts --dry-run",
    "check:seed": "tsx --tsconfig tsconfig.app.json scripts/check-seed.ts"
  },
  "dependencies": {
    "@heroui/react": "^2.8.5",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "framer-motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "firebase-admin": "^14.4.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.14",
    "vite-plugin-pwa": "^1.0.3"
  }
}
